<h1>アクティビティ一覧</h1>

<%= form_with url: sync_activities_path, method: :post do |f| %>
  <%= f.submit "Stravaから同期する", data: { disable_with: "同期中..." } %>
<% end %>

<% if @activities.empty? %>
  <p>アクティビティがありません。上のボタンでStravaから取得してください。</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>日付</th>
        <th>名前</th>
        <th>距離 (km)</th>
        <th>タイム</th>
        <th>ペース</th>
        <th>平均心拍</th>
      </tr>
    </thead>
    <tbody>
      <% @activities.each do |activity| %>
        <tr>
          <td><%= activity.start_date&.strftime("%Y/%m/%d") %></td>
          <td><%= activity.name %></td>
          <td><%= activity.distance_km %></td>
          <td><%= activity.moving_time ? "%d:%02d:%02d" % [activity.moving_time / 3600, (activity.moving_time % 3600) / 60, activity.moving_time % 60] : "-" %></td>
          <td><%= activity.pace_display %></td>
          <td><%= activity.average_heartrate&.round || "-" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
