<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Running Load Analyzer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body>
    <% flash.each do |type, message| %>
      <% next if type == "reauth_required" %>
      <p class="flash flash--<%= type %>"><%= message %></p>
    <% end %>
    <% if flash[:reauth_required] %>
      <div class="bg-yellow-50 border border-yellow-300 rounded p-4 mx-4 mt-4">
        <p class="text-yellow-800 font-medium mb-2">Stravaのアクティビティ読み込み権限が不足しています</p>
        <p class="text-yellow-700 text-sm mb-3">
          ログアウト後、トップページの「Stravaでログイン」から再度ログインしてください。
          このアプリへのログインはStravaで行うため、Stravaでログインすれば完了します。
        </p>
        <%= button_to "ログアウトする", destroy_user_session_path, method: :delete,
              class: "bg-gray-700 hover:bg-gray-800 text-white text-sm font-medium px-4 py-2 rounded" %>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
