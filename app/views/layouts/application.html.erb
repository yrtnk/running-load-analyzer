<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Running Load Analyzer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <div class="max-w-2xl mx-auto px-4 pt-4 space-y-3">
      <% flash.each do |type, message| %>
        <% next if type == "reauth_required" %>
        <% color = type == "notice" ? "bg-green-50 border-green-300 text-green-800" : "bg-red-50 border-red-300 text-red-800" %>
        <p class="border rounded px-4 py-3 text-sm <%= color %>"><%= message %></p>
      <% end %>
      <% if flash[:reauth_required] %>
        <div class="bg-yellow-50 border border-yellow-300 rounded px-4 py-3">
          <p class="text-yellow-800 font-medium text-sm mb-1">Stravaのアクティビティ読み込み権限が不足しています</p>
          <p class="text-yellow-700 text-sm mb-3">このアプリからログアウトし、Stravaで再度ログインすると解決します。</p>
          <%= button_to "ログアウトする", destroy_user_session_path, method: :delete,
                class: "bg-gray-700 hover:bg-gray-800 text-white text-xs font-medium px-3 py-1.5 rounded" %>
        </div>
      <% end %>
    </div>
    <%= yield %>
  </body>
</html>
