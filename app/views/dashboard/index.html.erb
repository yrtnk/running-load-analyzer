<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<% end %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-800 mb-8">ダッシュボード</h1>

  <%# 故障リスクアラート %>
  <% if @load_data[:injury_risk] %>
    <div class="mb-6 bg-red-50 border border-red-300 rounded-lg px-5 py-4 flex items-start gap-3">
      <span class="text-red-500 text-xl leading-tight">&#9888;</span>
      <div>
        <p class="font-semibold text-red-700">故障リスクが高まっています</p>
        <p class="text-sm text-red-600 mt-1">
          直近7日の平均負荷（STL）が直近30日平均（LTL）の120%を超えています。
          トレーニング量を落として回復を優先してください。
        </p>
      </div>
    </div>
  <% end %>

  <%# 負荷指標カード %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg shadow p-4 text-center">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">STL（7日平均）</p>
      <p class="text-2xl font-bold text-blue-600"><%= @load_data[:current_stl] %></p>
      <p class="text-xs text-gray-400 mt-1">日次負荷スコア</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4 text-center">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">LTL（30日平均）</p>
      <p class="text-2xl font-bold text-green-600"><%= @load_data[:current_ltl] %></p>
      <p class="text-xs text-gray-400 mt-1">日次負荷スコア</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4 text-center">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">STL / LTL</p>
      <% ratio = @load_data[:current_ltl].zero? ? nil : (@load_data[:current_stl] / @load_data[:current_ltl] * 100).round(0) %>
      <p class="text-2xl font-bold <%= @load_data[:injury_risk] ? 'text-red-600' : 'text-gray-800' %>">
        <%= ratio ? "#{ratio}%" : "-" %>
      </p>
      <p class="text-xs text-gray-400 mt-1">理想範囲: 80〜120%</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4 text-center">
      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">STL − LTL</p>
      <% diff = @load_data[:stl_ltl_diff] %>
      <p class="text-2xl font-bold <%= diff >= 0 ? 'text-orange-500' : 'text-blue-400' %>">
        <%= diff >= 0 ? "+#{diff}" : diff %>
      </p>
      <p class="text-xs text-gray-400 mt-1">日次差分</p>
    </div>
  </div>

  <%# 週間負荷グラフ %>
  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">週間負荷（過去12週）</h2>
    <div class="relative" style="height: 300px;">
      <canvas id="weeklyLoadChart"></canvas>
    </div>
    <div class="mt-3 flex items-center gap-6 text-xs text-gray-500">
      <span class="flex items-center gap-1">
        <span class="inline-block w-3 h-3 rounded-sm bg-blue-400 opacity-70"></span>週間合計負荷
      </span>
      <span class="flex items-center gap-1">
        <span class="inline-block w-4 border-t-2 border-green-500"></span>LTL（30日平均×7、週スケール）
      </span>
    </div>
  </div>

  <%# 直近Activityの一覧 %>
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-700">直近のアクティビティ</h2>
    </div>
    <% if @recent_activities.empty? %>
      <div class="px-6 py-10 text-center text-gray-400">
        <p>アクティビティがありません。</p>
        <%= form_with url: sync_activities_path, method: :post, class: "mt-4 inline-block" do |f| %>
          <%= f.submit "Stravaから同期する", class: "bg-orange-500 hover:bg-orange-600 text-white text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
        <% end %>
      </div>
    <% else %>
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">日付</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">タイトル</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">距離 (km)</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">ペース</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">負荷スコア</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @recent_activities.each do |activity| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm text-gray-600 whitespace-nowrap">
                <%= activity.start_date&.strftime("%Y/%m/%d") || "-" %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-800 max-w-xs truncate">
                <%= activity.name %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700 text-right whitespace-nowrap">
                <%= activity.distance_km %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-700 text-right whitespace-nowrap">
                <%= activity.pace_display %>
              </td>
              <td class="px-4 py-3 text-sm text-right font-semibold whitespace-nowrap">
                <span class="<%= activity.load_score_color %>">
                  <%= activity.load_score&.round(1) || "-" %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="px-6 py-3 border-t border-gray-100 text-right">
        <%= link_to "すべて見る →", activities_path, class: "text-sm text-blue-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const chartData = <%= @load_data[:chart_data].to_json.html_safe %>;

    const ctx = document.getElementById('weeklyLoadChart').getContext('2d');
    new Chart(ctx, {
      data: {
        labels: chartData.labels,
        datasets: [
          {
            type: 'bar',
            label: '週間合計負荷',
            data: chartData.weekly_totals,
            backgroundColor: 'rgba(96, 165, 250, 0.6)',
            borderColor: 'rgba(96, 165, 250, 0.9)',
            borderWidth: 1,
            order: 2
          },
          {
            type: 'line',
            label: 'LTL（30日平均×7）',
            data: chartData.ltl_values,
            borderColor: 'rgba(34, 197, 94, 0.9)',
            backgroundColor: 'rgba(34, 197, 94, 0.1)',
            borderWidth: 2,
            pointRadius: 3,
            tension: 0.3,
            fill: false,
            order: 1
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                return ctx.dataset.label + ': ' + ctx.parsed.y;
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { size: 11 } }
          },
          y: {
            beginAtZero: true,
            ticks: { font: { size: 11 } },
            title: { display: true, text: '負荷スコア', font: { size: 11 } }
          }
        }
      }
    });
  })();
</script>
